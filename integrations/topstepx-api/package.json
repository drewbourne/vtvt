{
  "name": "@fbt/topstepx-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "generate": "yarn convert:gateway && yarn convert:user && openapi-ts -f openapi-ts.config.ts",
    "convert:gateway": "swagger2openapi swagger/gateway-v1.0.0.json --outfile openapi/gateway-v1.0.0.json",
    "convert:user": "swagger2openapi  swagger/user-v1.0.0.json --outfile openapi/user-v1.0.0.json"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fbt/typescript-config": "workspace:*",
    "@hey-api/openapi-ts": "0.87.2",
    "swagger2openapi": "^7.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.3",
    "vite-plugin-dts": "^5.0.3"
  },
  "exports": {
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway.js"
    },
    "./gateway-client": {
      "types": "./dist/gateway/client.gen.d.ts",
      "import": "./dist/gateway-client.js"
    },
    "./user": {
      "types": "./dist/user/index.d.ts",
      "import": "./dist/user.js"
    },
    "./user-client": {
      "types": "./dist/user/client.gen.d.ts",
      "import": "./dist/user-client.js"
    }
  }
}
