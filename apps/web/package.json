  "private": true,
  "type": "module",
  "dependencies": {
    "@fbt/accounts": "workspace:*",
    "@fbt/logging": "workspace:*",
    "@fbt/market": "workspace:*",
    "@fbt/nats": "workspace:*",
    "@fbt/otel": "workspace:*",
    "@fbt/typescript-config": "workspace:*",
    "@fbt/watchlist": "workspace:*",
    "@logtape/logtape": "^2.2.4",
    "@logtape/pretty": "^2.2.4",
    "awilix": "^13.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
